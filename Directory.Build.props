<Project>
    <PropertyGroup>
        <LangVersion>14</LangVersion>
        <TargetFramework>net10.0</TargetFramework>
        <TieredPGO>true</TieredPGO>
        <TieredCompilation>true</TieredCompilation>
        <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
        <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <IsPackable>true</IsPackable>
        <WarningLevel>4</WarningLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <PropertyGroup>
        <NeutralLanguage>en</NeutralLanguage>
        <Copyright>Copyright @ Sichi 2018-2023</Copyright>
        <PackageProjectUrl>https://www.hybrasyl.com/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/hybrasyl/Brigid</RepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
        <Authors>Sichi</Authors>
        <PackageTags>darkages; doomvas; private server;</PackageTags>
        <!-- Local/dev version — keep matching the latest release tag so the login-screen label reads
             correctly and the update check doesn't false-positive. Release builds override this with
             -p:Version from the tag (see .github/workflows/release.yml). -->
        <Version>0.5.0</Version>

        <!-- DALib is consumed from the pinned NuGet package by default. Opt into the sibling checkout
             with -p:UseLocalDALib=true when co-developing DALib alongside Brigid.
             Hybrasyl protocol divergence deliberately does NOT live in DALib (retail/USDA ground
             truth) — see Brigid.Networking/Definitions/HybrasylExtensions.cs. -->
        <UseLocalDALib Condition="'$(UseLocalDALib)' == ''">false</UseLocalDALib>
        <LocalDALibProjectPath Condition="'$(LocalDALibProjectPath)' == ''">$(MSBuildThisFileDirectory)..\dalib\DALib\DALib.csproj</LocalDALibProjectPath>

        <!-- Hybrasyl.Protocol (repo: sreang) carries the extended-framing dialect shared with the
             Hybrasyl server. Same toggle shape as DALib: -p:UseLocalProtocol=false uses the pinned
             package instead of the sibling checkout.
             TEMPORARY: defaults to the sibling checkout because 0.0.2 is not published yet, and
             0.0.1 is both source- and wire-incompatible with it (DialectOffer's members were renamed,
             and negotiation moved into a 0xFF envelope). Flip this default back to false the day
             0.0.2 lands on NuGet — the pinned version above is already correct. Until then a release
             build fails loudly on a missing package rather than quietly producing a client that
             cannot negotiate. -->
        <UseLocalProtocol Condition="'$(UseLocalProtocol)' == ''">true</UseLocalProtocol>
        <LocalProtocolProjectPath Condition="'$(LocalProtocolProjectPath)' == ''">$(MSBuildThisFileDirectory)..\sreang\src\Hybrasyl.Protocol\Hybrasyl.Protocol.csproj</LocalProtocolProjectPath>
    </PropertyGroup>

</Project>