<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- WinExe (GUI subsystem): a game client owns no console. As a console Exe, a direct
             binary spawn (e.g. Epona) pops a stray console and, when spawned with SW_HIDE, the
             window can be created hidden. WinExe removes the console entirely; stdout still flows
             to a redirected/inherited pipe (dotnet-run, Epona LogPane) when a parent provides one.
             Trade-off: NoticeDebugLog's Console.Write no longer echoes to an attached terminal on
             a bare double-click — the notice-debug.log file remains the durable sink. -->
        <OutputType>WinExe</OutputType>
        <IsPackable>false</IsPackable>
        <!-- Entry assembly / apphost: Brigid / Brigid.exe / Brigid.dll. -->
        <AssemblyName>Brigid</AssemblyName>
        <ApplicationIcon>BrigidIcon.ico</ApplicationIcon>
    </PropertyGroup>

    <!-- Window icon: decoded by SkiaSharp and applied via SDL_SetWindowIcon in ChaosGame (MonoGame's built-in
         Icon.bmp loader can't parse it, so we set it ourselves). The .ico above is the Windows exe/apphost icon. -->
    <ItemGroup>
        <EmbeddedResource Include="BrigidIcon.png">
            <LogicalName>BrigidIcon.png</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Brigid.Tests" />
    </ItemGroup>

    <!-- On macOS, SslStream defaults to Apple's SecureTransport, which cannot go above TLS 1.2 — the
         extension channel requires 1.3, so without this a macOS client cannot reach it. This selects
         Network.framework instead, which supports 1.3. No effect on Linux or Windows.
         Set through runtimeconfig rather than AppContext.SetSwitch in Main so the host applies it
         before any code runs: the switch is only read when SslStream first initializes its backend,
         and a call ordered after that would be silently ignored.
         Governs client operations only. A server on macOS is separately limited to 1.2, measured by
         a Linux client reaching only 1.2 against one while reaching 1.3 against a Linux server on
         the same binary — so a macOS host is a viable client for this channel and not a viable
         server. A macOS-to-macOS loopback is capped at both ends and cannot show which end binds. -->
    <ItemGroup>
        <RuntimeHostConfigurationOption Include="System.Net.Security.UseNetworkFramework" Value="true" />
    </ItemGroup>

    <!-- Native SDL2_mixer binaries per runtime; copied to bin/.../runtimes/{rid}/native/ so the
         standard .NET native-DLL probe picks them up via [LibraryImport("SDL2_mixer")].
         SDL2.dll itself is provided by MonoGame.Framework.DesktopGL's own runtimes payload. -->
    <ItemGroup>
        <Content Include="runtimes\**\*.dll;runtimes\**\*.dylib;runtimes\**\*.so*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Content\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Brigid.Data\Brigid.Data.csproj"/>
        <ProjectReference Include="..\Brigid.Rendering\Brigid.Rendering.csproj"/>
        <ProjectReference Include="..\Brigid.Networking\Brigid.Networking.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Chaos.Pathfinding"/>
        <!-- SkiaSharp ships win32/macOS natives transitively (via DALib), but Linux natives
             live in a separate package that must be referenced explicitly — without it a
             linux-x64 publish has no libSkiaSharp.so and crashes at the first text draw. -->
        <PackageReference Include="SkiaSharp.NativeAssets.Linux"/>
        <PackageReference Include="TextCopy"/>
    </ItemGroup>
</Project>
